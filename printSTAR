import java.util.*;

public class Main {
    public static void main(String[] args) {
      int i,n,j;
      Scanner s = new Scanner(System.in);
      System.out.print("Enter the val of n : ");

      n=s.nextInt();

      for(i=0;i<=n;i++){

        for(j=1;j<=i;j++){

          System.out.print(" *");
        }
        System.out.println("  ");
      }
      
    }
}